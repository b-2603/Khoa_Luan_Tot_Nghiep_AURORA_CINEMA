APP_NAME=AuroraCustomer
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL="http://localhost/AURORA%20CINEMA/customer/backend/public"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aurora_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# URL frontend nhận kết quả sau khi Google/Facebook xác thực xong.
CUSTOMER_FRONTEND_URL="http://localhost:3000"
MAIL_FROM_ADDRESS="no-reply@auroracinema.local"
# Chuỗi ngẫu nhiên riêng dùng để băm IP trong nhật ký OAuth (không dùng APP_KEY).
OAUTH_AUDIT_SALT=change-this-to-a-long-random-value

# Tạo OAuth 2.0 Web Client tại Google Cloud Console. Google không có chế độ giả lập;
# nút đăng nhập chỉ được bật khi có cả Client ID và Secret. Redirect URI phải khớp
# chính xác với GOOGLE_REDIRECT_URI và được khai báo trong Authorized redirect URIs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost/AURORA%20CINEMA/customer/backend/public/api.php?action=oauth_callback&provider=google"

# Tạo Meta App có Facebook Login tại Meta for Developers. Bật Client OAuth
# Login + Web OAuth Login; Valid OAuth Redirect URI phải khớp tuyệt đối với
# FACEBOOK_REDIRECT_URI. Không dùng App ID/Secret mẫu hoặc tài khoản giả lập.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_GRAPH_VERSION=v25.0
FACEBOOK_REDIRECT_URI="http://localhost/AURORA%20CINEMA/customer/backend/public/api.php?action=oauth_callback&provider=facebook"
