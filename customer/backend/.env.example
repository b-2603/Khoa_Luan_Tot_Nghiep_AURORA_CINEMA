APP_NAME="Customer Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aurora_db
DB_USERNAME=root
DB_PASSWORD=

# OAuth social login (fill these values before using Google/Facebook login)
AURORA_GOOGLE_CLIENT_ID=
AURORA_FACEBOOK_APP_ID=
AURORA_OAUTH_REDIRECT_URI=http://localhost/AURORA%20CINEMA/customer/backend/public/api.php?action=oauth_callback
AURORA_FRONTEND_URL=http://localhost:3000

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
